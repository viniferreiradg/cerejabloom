# Banco: em produção, Postgres. Deixe vazio para usar um arquivo SQLite
# local (cerejabloom.db), bom para rodar no computador sem instalar nada.
DATABASE_URI=postgresql://user:password@host:5432/cerejabloom

PAYLOAD_SECRET=troque-por-uma-string-aleatoria-com-32-caracteres
NEXT_PUBLIC_SERVER_URL=https://cerejabloom.com.br

# Segredo do POST /revalidate (chamado pelo admin a cada "Salvar")
REVALIDATE_SECRET=troque-este-segredo

# Lojinha (/lojinha): Supabase → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
